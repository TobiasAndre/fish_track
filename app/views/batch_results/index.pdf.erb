<style>
  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11px;
    color: #111;
    background: #fff;
  }

  .header {
    border-bottom: 2px solid #222;
    padding-bottom: 10px;
    margin-bottom: 18px;
  }

  .title {
    font-size: 22px;
    font-weight: bold;
    margin: 0;
  }

  .subtitle {
    font-size: 12px;
    color: #555;
    margin-top: 4px;
  }

  .section-title {
    font-size: 15px;
    font-weight: bold;
    margin: 18px 0 8px;
    padding-bottom: 4px;
    border-bottom: 1px solid #ccc;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 14px;
  }

  th {
    background: #f0f0f0;
    border: 1px solid #bbb;
    padding: 6px;
    text-align: left;
    font-weight: bold;
  }

  td {
    border: 1px solid #ccc;
    padding: 6px;
    vertical-align: top;
  }

  .master-table td {
    font-weight: bold;
  }

  .text-right {
    text-align: right;
  }

  .income {
    color: #15803d;
  }

  .expense {
    color: #b91c1c;
  }

  .muted {
    color: #777;
  }

  .badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 8px;
    font-size: 10px;
    border: 1px solid #ccc;
  }

  .badge-overdue {
    background: #fef3c7;
    border-color: #f59e0b;
    color: #92400e;
  }

  .badge-settled {
    background: #dcfce7;
    border-color: #22c55e;
    color: #166534;
  }

  .empty {
    text-align: center;
    color: #777;
    padding: 18px;
  }

  .footer {
    margin-top: 24px;
    padding-top: 8px;
    border-top: 1px solid #ccc;
    font-size: 10px;
    color: #666;
  }
</style>

<% money = ->(cents) { number_to_currency(cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") } %>
<% margin = ->(row) { row.margin_percent ? "#{number_with_precision(row.margin_percent, precision: 1, separator: ',', delimiter: '.')}%" : "-" } %>
<% status_labels = { "active" => "Ativos", "closed" => "Encerrados" } %>
<% total = @result.total %>
<% unallocated = @result.unallocated %>

<div class="header">
  <h1 class="title">Resultado por Lote</h1>

  <div class="subtitle">
    Gerado em <%= l((@generated_at || Time.current).to_date) %>
  </div>
</div>

<div class="section-title">Filtros utilizados</div>

<table>
  <tbody>
    <tr>
      <th scope="row">Situação do lote</th>
      <td><%= status_labels[@q_status] || "Todos" %></td>

      <th scope="row">Competência de</th>
      <td><%= @q_from.presence || "—" %></td>

      <th scope="row">Competência até</th>
      <td><%= @q_to.presence || "—" %></td>
    </tr>
  </tbody>
</table>

<div class="section-title">Resultado</div>

<table>
  <thead>
    <tr>
      <th>Lote</th>
      <th>Situação</th>
      <th>Receita</th>
      <th>Custo</th>
      <th>Resultado</th>
      <th>Margem</th>
      <th>Recebido</th>
      <th>Pago</th>
      <th>Caixa</th>
    </tr>
  </thead>

  <tbody>
    <% if @result.rows.any? %>
      <% @result.rows.each do |row| %>
        <tr>
          <td><%= row.batch.name %></td>
          <td><%= row.batch.active_status? ? "Ativo" : "Encerrado" %></td>
          <td class="text-right"><%= money.call(row.revenue_cents) %></td>
          <td class="text-right"><%= money.call(row.cost_cents) %></td>
          <td class="text-right"><%= money.call(row.result_cents) %></td>
          <td class="text-right"><%= margin.call(row) %></td>
          <td class="text-right"><%= money.call(row.received_cents) %></td>
          <td class="text-right"><%= money.call(row.paid_cents) %></td>
          <td class="text-right"><%= money.call(row.cash_result_cents) %></td>
        </tr>
      <% end %>
      <tr>
        <th colspan="2">Total</th>
        <th class="text-right"><%= money.call(total.revenue_cents) %></th>
        <th class="text-right"><%= money.call(total.cost_cents) %></th>
        <th class="text-right"><%= money.call(total.result_cents) %></th>
        <th class="text-right"><%= margin.call(total) %></th>
        <th class="text-right"><%= money.call(total.received_cents) %></th>
        <th class="text-right"><%= money.call(total.paid_cents) %></th>
        <th class="text-right"><%= money.call(total.cash_result_cents) %></th>
      </tr>
    <% else %>
      <tr>
        <td colspan="9" class="empty">Nenhum lote com lançamentos financeiros neste filtro.</td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="footer">
  Receita e custo por data de competência; recebido, pago e caixa consideram só o liquidado. Margem = resultado / receita.
  Lançamentos sem lote (não incluídos): receita <%= money.call(unallocated.revenue_cents) %> · custo <%= money.call(unallocated.cost_cents) %>.
</div>
