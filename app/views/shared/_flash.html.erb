<%# data-turbo-temporary: fora do cache do Turbo, para não repetir o toast ao voltar. %>
<% if notice.present? %>
  <div hidden data-turbo-temporary data-controller="flash" data-flash-type-value="success" data-flash-message-value="<%= notice %>"></div>
<% end %>

<% if alert.present? %>
  <div hidden data-turbo-temporary data-controller="flash" data-flash-type-value="error" data-flash-message-value="<%= alert %>"></div>
<% end %>
