<div class="max-w-4xl mx-auto space-y-4">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Perfis de acesso</h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
        Conjuntos de permissões por página (visualizar, criar, editar e excluir) para os usuários da empresa.
      </p>
    </div>

    <%= link_to "Novo perfil", new_access_profile_path,
      class: "shrink-0 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium transition" %>
  </div>

  <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 dark:bg-gray-950/40 text-gray-600 dark:text-gray-300">
        <tr>
          <th class="text-left px-4 py-3 font-medium">Perfil</th>
          <th class="text-left px-4 py-3 font-medium">Descrição</th>
          <th class="text-right px-4 py-3 font-medium">Permissões</th>
          <th class="text-right px-4 py-3 font-medium">Ações</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
        <% @profiles.each do |profile| %>
          <tr>
            <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100"><%= profile.name %></td>
            <td class="px-4 py-3 text-gray-600 dark:text-gray-300"><%= profile.description.presence || "—" %></td>
            <td class="px-4 py-3 text-right text-gray-700 dark:text-gray-200"><%= profile.permissions_count %></td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-2">
                <%= link_to edit_access_profile_path(profile), title: "Editar", aria: { label: "Editar" },
                  class: "px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 transition" do %>
                  <i class="fa-solid fa-pen-to-square"></i>
                <% end %>

                <%= button_to access_profile_path(profile), method: :delete, title: "Excluir", aria: { label: "Excluir" },
                  data: { turbo_confirm: "Excluir o perfil #{profile.name}?" },
                  class: "px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition cursor-pointer" do %>
                  <i class="fa-solid fa-trash-can"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>

        <% if @profiles.empty? %>
          <tr>
            <td colspan="4" class="px-4 py-6 text-center text-gray-500 dark:text-gray-400">
              Nenhum perfil criado ainda. <%= link_to "Criar o primeiro perfil", new_access_profile_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
