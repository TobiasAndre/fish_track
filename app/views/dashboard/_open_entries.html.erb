<%# Contas em aberto (a pagar ou a receber), do vencimento mais próximo ao mais distante: item e saldo em aberto. %>
<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
  <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100"><%= title %></h2>
    <%= link_to "Ver todos", filter_path, class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
  </div>

  <% if entries.any? %>
    <table class="w-full text-sm">
      <thead class="text-xs text-gray-500 dark:text-gray-400">
        <tr>
          <th class="px-4 py-2 text-left font-medium">Item</th>
          <th class="px-4 py-2 text-right font-medium">Valor</th>
        </tr>
      </thead>

      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        <% entries.each do |entry| %>
          <tr class="<%= "bg-amber-50/60 dark:bg-amber-900/10" if entry.overdue? %>">
            <td class="px-4 py-2">
              <div class="text-gray-900 dark:text-gray-100"><%= entry.description %></div>
              <div class="text-xs <%= entry.overdue? ? "font-medium text-amber-700 dark:text-amber-300" : "text-gray-500 dark:text-gray-400" %>">
                <%= entry.overdue? ? "Vencido em" : "Vence em" %> <%= l(entry.due_on) %>
              </div>
            </td>
            <td class="px-4 py-2 text-right font-medium whitespace-nowrap <%= amount_class %>">
              <%= number_to_currency(entry.balance_cents / 100.0) %>
            </td>
          </tr>
        <% end %>
      </tbody>

      <tfoot>
        <tr class="border-t-2 border-gray-200 dark:border-gray-800 font-semibold text-gray-900 dark:text-gray-100">
          <td class="px-4 py-2">
            Total em aberto
            <% if count > entries.size %>
              <span class="text-xs font-normal text-gray-500 dark:text-gray-400">(<%= entries.size %> de <%= count %> itens)</span>
            <% end %>
          </td>
          <td class="px-4 py-2 text-right whitespace-nowrap"><%= number_to_currency(total_cents / 100.0) %></td>
        </tr>
      </tfoot>
    </table>
  <% else %>
    <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400"><%= empty_text %></div>
  <% end %>
</div>
