<div class="max-w-6xl mx-auto">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Dashboard</h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
        Visão geral dos lotes ativos e das contas a pagar e a receber.
      </p>
    </div>

    <div class="flex gap-2">
      <%= link_to "Lotes", batches_path,
        class: "px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                hover:bg-gray-50 dark:hover:bg-gray-800 transition" %>
      <%= link_to "Tanques", ponds_path,
        class: "px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                hover:bg-gray-50 dark:hover:bg-gray-800 transition" %>
    </div>
  </div>

  <%# Totais dos lotes ativos: alojados/entregues vêm das lotações e dos carregamentos; despesa e faturamento, dos lançamentos do Financeiro vinculados aos lotes. %>
  <div class="mt-6 grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">Peixes alojados</p>
      <p class="mt-1 text-xl sm:text-2xl font-semibold whitespace-nowrap text-gray-900 dark:text-gray-100"><%= number_with_delimiter(@figures.stocked_quantity, delimiter: ".") %></p>
    </div>

    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">Peixes entregues</p>
      <p class="mt-1 text-xl sm:text-2xl font-semibold whitespace-nowrap text-gray-900 dark:text-gray-100"><%= number_with_delimiter(@figures.delivered_quantity, delimiter: ".") %></p>
    </div>

    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">Despesa total</p>
      <p class="mt-1 text-xl sm:text-2xl font-semibold whitespace-nowrap text-red-700 dark:text-red-300"><%= number_to_currency(@figures.expense_cents / 100.0) %></p>
    </div>

    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
      <p class="text-xs text-gray-500 dark:text-gray-400">Faturamento total</p>
      <p class="mt-1 text-xl sm:text-2xl font-semibold whitespace-nowrap text-green-700 dark:text-green-300"><%= number_to_currency(@figures.revenue_cents / 100.0) %></p>
    </div>
  </div>
  <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
    Somando os <%= pluralize(@active_batches_count, "lote ativo", "lotes ativos") %>.
  </p>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900">
      <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-800 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Lotes ativos</h2>
        <%= link_to "Ver todos", batches_path, class: "text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
      </div>

      <div class="p-4 flex flex-col gap-3">
        <% @active_batches.each do |b| %>
          <% unit_names = b.batch_stockings.map { |s| s.pond.unit.name }.uniq.join(", ") %>
          <% pond_names = b.batch_stockings.map { |s| s.pond.name }.uniq.join(", ") %>
          <% current_quantity = b.current_quantity.to_i %>
          <% current_biomass = b.current_biomass_kg.to_d %>

          <% batch_figures = @figures.for(b) %>
          <% latest_biometry = b.batch_stockings
            .flat_map(&:stocking_events)
            .select { |event| event.event_type == "biometrics" }
            .max_by { |event| [event.occurred_on || Date.new(1900, 1, 1), event.created_at] } %>

          <%= link_to edit_batch_path(b),
            class: "rounded-xl border border-gray-200 dark:border-gray-800
                    hover:bg-gray-50 dark:hover:bg-gray-800/40 transition p-4" do %>

            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-medium text-gray-900 dark:text-gray-100"><%= b.name %></p>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
                  <%= unit_names.presence || "—" %> • Tanque: <%= pond_names.presence || "—" %>
                </p>
              </div>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs font-medium
                           bg-green-100 text-green-800 dark:bg-green-950/40 dark:text-green-300">
                Ativo
              </span>
            </div>

            <div class="mt-3 flex flex-wrap gap-2">
              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                Atual: <%= current_quantity.positive? ? number_with_delimiter(current_quantity, delimiter: ".") : "—" %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                Biomassa: <%= current_biomass.positive? ? number_with_precision(current_biomass, precision: 2, separator: ",", delimiter: ".") : "—" %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                Ganho: <%= latest_biometry&.weight_gain_kg.present? ? number_with_precision(latest_biometry.weight_gain_kg, precision: 2, separator: ",", delimiter: ".") : "—" %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                GPD: <%= latest_biometry&.gpd.present? ? number_with_precision(latest_biometry.gpd, precision: 3, separator: ",", delimiter: ".") : "—" %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                Peso: <%= b.avg_weight_g ? "#{number_with_precision(b.avg_weight_g, precision: 2, separator: ",", delimiter: ".")}g" : "—" %>
              </span>
            </div>

            <div class="mt-2 flex flex-wrap gap-2">
              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
                Carregado: <%= batch_figures.loaded_quantity.positive? ? number_with_delimiter(batch_figures.loaded_quantity, delimiter: ".") : "—" %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-red-50 text-red-800 dark:bg-red-950/40 dark:text-red-300">
                Despesa: <%= number_to_currency(batch_figures.expense_cents / 100.0) %>
              </span>

              <span class="inline-flex items-center px-2 py-1 rounded-lg text-xs
                           bg-green-50 text-green-800 dark:bg-green-950/40 dark:text-green-300">
                Faturamento: <%= number_to_currency(batch_figures.revenue_cents / 100.0) %>
              </span>
            </div>
          <% end %>
        <% end %>

        <% if @active_batches.empty? %>
          <div class="text-sm text-gray-500 dark:text-gray-400">
            Nenhum lote ativo ainda. <%= link_to "Criar um lote", new_batch_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <%= render "dashboard/open_entries",
            title: "A pagar", entries: @payables, total_cents: @payables_total_cents, count: @payables_count,
            filter_path: financial_entries_path(entry_type: "expense", status: "pending"),
            amount_class: "text-red-700 dark:text-red-300", empty_text: "Nada a pagar em aberto." %>

      <%= render "dashboard/open_entries",
            title: "A receber", entries: @receivables, total_cents: @receivables_total_cents, count: @receivables_count,
            filter_path: financial_entries_path(entry_type: "income", status: "pending"),
            amount_class: "text-green-700 dark:text-green-300", empty_text: "Nada a receber em aberto." %>
    </div>
  </div>
</div>
