<% kg = ->(value) { value ? number_with_precision(value, precision: 2, strip_insignificant_zeros: true, separator: ",", delimiter: ".") : "—" } %>
<% mins = ->(value) { value ? number_with_precision(value, precision: 1, strip_insignificant_zeros: true, separator: ",", delimiter: ".") : "—" } %>
<% temp_label = ->(range) { "#{range.temperature_from.to_i}–#{range.temperature_to.to_i}°C" } %>
<% temperature_ranges = @plan.temperature_ranges %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Arraçoamento</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Trato (kg) e tempo (min) por tanque em cada faixa de temperatura da água, a partir da biomassa dos lotes ativos.
    </p>
  </div>

  <%# Só o conteúdo abaixo é recarregado ao trocar um filtro (Turbo Frame): o cabeçalho, o menu e a posição da rolagem ficam parados. %>
  <%= turbo_frame_tag "feeding_plan", data: { turbo_action: "advance" }, class: "block space-y-6 transition-opacity aria-busy:opacity-60" do %>
  <%= render "feeding_plans/share_opener" %>
  <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
    <%= form_with url: feeding_plans_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3", data: { controller: "auto-submit" } do %>
      <div class="w-64">
        <%= label_tag :feeding_table_id, "Tabela de arraçoamento", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
        <%= select_tag :feeding_table_id,
          options_from_collection_for_select(@feeding_tables, :id, :name, @feeding_table&.id),
          include_blank: @feeding_tables.any? ? false : "—",
          data: { action: "change->auto-submit#submit" },
          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div class="w-56">
        <%= label_tag :unit_id, "Unidade", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
        <%= select_tag :unit_id,
          options_from_collection_for_select(@units, :id, :name, @selected_unit_id),
          prompt: "Selecione a unidade",
          data: { action: "change->auto-submit#submit" },
          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div class="w-56">
        <%= label_tag :batch_id, "Lote", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
        <%= select_tag :batch_id,
          options_from_collection_for_select(@batches_for_select, :id, :name, @selected_batch_id),
          prompt: "Todos os lotes",
          disabled: @selected_unit_id.blank?,
          data: { action: "change->auto-submit#submit" },
          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>

      <% if @selected_unit_id.present? && @ponds_for_select.any? %>
        <div class="w-full">
          <span class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">
            Tanques <span class="font-normal">(marque um ou mais para reduzir a tabela; nenhum marcado = todos)</span>
          </span>

          <div class="flex flex-wrap items-center gap-2">
            <% @ponds_for_select.each do |pond| %>
              <label for="pond_ids_<%= pond.id %>"
                class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-200 cursor-pointer select-none
                       has-checked:border-indigo-500 has-checked:bg-indigo-50 has-checked:text-indigo-700 dark:has-checked:bg-indigo-950 dark:has-checked:text-indigo-300">
                <%= check_box_tag "pond_ids[]", pond.id, @selected_pond_ids.include?(pond.id.to_s),
                  id: "pond_ids_#{pond.id}",
                  class: "rounded border-gray-300 dark:border-gray-700 text-indigo-600 focus:ring-indigo-500" %>
                <%= pond.name %>
              </label>
            <% end %>

            <%= submit_tag "Filtrar tanques", name: nil,
              class: "px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium transition cursor-pointer" %>

            <% if @selected_pond_ids.any? %>
              <%= link_to "Todos os tanques",
                feeding_plans_path(feeding_table_id: @feeding_table&.id, unit_id: @selected_unit_id, batch_id: @selected_batch_id),
                class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 underline" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @feeding_table.blank? %>
      <div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-200">
        Cadastre uma <%= link_to "tabela de arraçoamento", new_feeding_table_path, data: { turbo_frame: "_top" }, class: "underline font-medium" %> com os percentuais para calcular o trato.
      </div>
    <% end %>
  </div>

  <% if @selected_unit_id.blank? %>
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400">
        Selecione a unidade acima para ver o trato e o tempo de arraçoamento dos tanques.
      </p>
    </div>
  <% elsif @ponds.empty? %>
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-8 text-center">
      <p class="text-sm text-gray-500 dark:text-gray-400">Nenhum tanque encontrado para o filtro selecionado.</p>
    </div>
  <% else %>
    <%# Imprimir (PDF) e WhatsApp usam exatamente os filtros que estão na tela. %>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= link_to feeding_plans_path(format: :pdf, feeding_table_id: @feeding_table&.id, unit_id: @selected_unit_id,
                                     batch_id: @selected_batch_id.presence, pond_ids: @selected_pond_ids.presence),
        target: "_blank", rel: "noopener", data: { turbo_frame: "_top" }, title: "Imprimir (PDF)",
        class: "inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800 transition" do %>
        <i class="fa-solid fa-print"></i> Imprimir
      <% end %>

      <%= form_with url: create_share_feeding_plans_path, method: :post, local: true, data: { turbo_action: "replace" } do %>
        <%= hidden_field_tag :feeding_table_id, @feeding_table&.id, id: nil %>
        <%= hidden_field_tag :unit_id, @selected_unit_id, id: nil %>
        <%= hidden_field_tag :batch_id, @selected_batch_id, id: nil %>
        <% @selected_pond_ids.each do |pond_id| %>
          <%= hidden_field_tag "pond_ids[]", pond_id, id: nil %>
        <% end %>

        <button type="submit" title="Enviar por WhatsApp"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-green-500 hover:bg-green-600 text-white text-sm font-medium transition cursor-pointer">
          <i class="fa-brands fa-whatsapp text-lg"></i> WhatsApp
        </button>
      <% end %>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
      <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">Trato (Kg) por temperatura</h2>

      <div class="overflow-x-auto">
        <table class="min-w-full text-xs">
          <thead class="bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
            <tr>
              <th class="px-2 py-2 text-left font-semibold">Tanque</th>
              <th class="px-2 py-2 text-right font-semibold">Qtde. peixes</th>
              <th class="px-2 py-2 text-right font-semibold">Peso médio (g)</th>
              <th class="px-2 py-2 text-right font-semibold">Biomassa (kg)</th>
              <th class="px-2 py-2 text-left font-semibold">Tanque</th>
              <% temperature_ranges.each do |range| %>
                <th class="px-2 py-2 text-right font-semibold whitespace-nowrap"><%= temp_label.call(range) %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800 text-gray-700 dark:text-gray-300">
            <% @plan.rows.each do |row| %>
              <tr>
                <td class="px-2 py-1.5 font-medium text-gray-900 dark:text-gray-100"><%= row.pond.name %></td>
                <td class="px-2 py-1.5 text-right"><%= row.quantity.positive? ? number_with_delimiter(row.quantity, delimiter: ".") : "—" %></td>
                <td class="px-2 py-1.5 text-right"><%= row.avg_weight_g.positive? ? number_with_precision(row.avg_weight_g, precision: 2, separator: ",", delimiter: ".") : "—" %></td>
                <td class="px-2 py-1.5 text-right"><%= row.biomass_kg.positive? ? kg.call(row.biomass_kg) : "—" %></td>
                <td class="px-2 py-1.5 whitespace-nowrap font-medium text-gray-900 dark:text-gray-100"><%= row.pond.name %></td>
                <% temperature_ranges.each do |range| %>
                  <td class="px-2 py-1.5 text-right"><%= kg.call(row.feed_kg_by_temp[range.id]) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">
        "—" indica que não há biomassa de lote ativo, peso médio, ou taxa de arraçoamento cadastrada para a faixa de peso/temperatura.
      </p>
    </div>

    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
      <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">Tempo (min) por temperatura</h2>

      <div class="overflow-x-auto">
        <table class="min-w-full text-xs">
          <thead class="bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
            <tr>
              <th class="px-2 py-2 text-left font-semibold">Tanque</th>
              <th class="px-2 py-2 text-right font-semibold">s/kg</th>
              <% temperature_ranges.each do |range| %>
                <th class="px-2 py-2 text-right font-semibold whitespace-nowrap"><%= temp_label.call(range) %></th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 dark:divide-gray-800 text-gray-700 dark:text-gray-300">
            <% @plan.rows.each do |row| %>
              <tr>
                <td class="px-2 py-1.5 font-medium text-gray-900 dark:text-gray-100"><%= row.pond.name %></td>
                <td class="px-2 py-1.5 text-right"><%= row.pond.feed_seconds_per_kg ? number_with_precision(row.pond.feed_seconds_per_kg, precision: 3, separator: ",", delimiter: ".") : "—" %></td>
                <% temperature_ranges.each do |range| %>
                  <td class="px-2 py-1.5 text-right"><%= mins.call(row.time_min_by_temp[range.id]) %></td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <% if can?("feeding_plans", :edit) %>
    <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-4">
      <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-1">Calibração de tempo</h2>
      <p class="text-xs text-gray-500 dark:text-gray-400 mb-3">
        Informe uma amostra por tanque (quantos kg de ração foram dados e em quantos segundos). O tempo de cada trato é estimado a partir dessa taxa.
      </p>

      <%= form_with url: calibrations_feeding_plans_path, method: :patch, local: true, data: { turbo_frame: "_top" } do %>
        <%= hidden_field_tag :feeding_table_id, @feeding_table&.id %>
        <%= hidden_field_tag :unit_id, @selected_unit_id %>
        <%= hidden_field_tag :batch_id, @selected_batch_id %>
        <% @selected_pond_ids.each do |pond_id| %>
          <%= hidden_field_tag "pond_ids[]", pond_id, id: nil %>
        <% end %>

        <div class="overflow-x-auto">
          <table class="min-w-full text-xs">
            <thead class="bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
              <tr>
                <th class="px-2 py-2 text-left font-semibold">Tanque</th>
                <th class="px-2 py-2 text-left font-semibold">Ração da amostra (kg)</th>
                <th class="px-2 py-2 text-left font-semibold">Tempo da amostra (s)</th>
                <th class="px-2 py-2 text-right font-semibold">s/kg</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800 text-gray-700 dark:text-gray-300">
              <% @ponds.each do |pond| %>
                <tr>
                  <td class="px-2 py-1.5 font-medium text-gray-900 dark:text-gray-100"><%= pond.name %></td>
                  <td class="px-2 py-1.5">
                    <%= number_field_tag "calibrations[#{pond.id}][feed_sample_kg]", pond.feed_sample_kg,
                      step: 0.001, min: 0,
                      class: "w-28 rounded-lg border px-2 py-1 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
                  </td>
                  <td class="px-2 py-1.5">
                    <%= number_field_tag "calibrations[#{pond.id}][feed_sample_seconds]", pond.feed_sample_seconds,
                      step: 0.01, min: 0,
                      class: "w-28 rounded-lg border px-2 py-1 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
                  </td>
                  <td class="px-2 py-1.5 text-right"><%= pond.feed_seconds_per_kg ? number_with_precision(pond.feed_seconds_per_kg, precision: 3, separator: ",", delimiter: ".") : "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <div class="mt-3">
          <%= submit_tag "Salvar calibração",
            class: "inline-flex items-center px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium transition cursor-pointer" %>
        </div>
      <% end %>
    </div>
    <% end %>
  <% end %>
  <% end %>
</div>
