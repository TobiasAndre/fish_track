<%# Depois de lançar um carregamento, abre o WhatsApp com o PDF compartilhável (controller open-url). %>
<% if params[:printable_event_id].present? && session[:tenant_name].present? %>
  <% printed_event = StockingEvent.find_by(id: params[:printable_event_id], event_type: "loading") %>
  <% if printed_event.present? %>
    <% printed_event.regenerate_share_token if printed_event.share_token.blank? %>
    <% company = Company.find_by(tenant_name: session[:tenant_name]) %>
    <% mensagem = "Carregamento #{company&.name}: #{printed_event.customer&.name || printed_event.batch_stocking.display_name}" %>
    <% pdf_url = shared_loading_event_pdf_url(
      tenant_name: session[:tenant_name],
      id: printed_event.id,
      share_token: printed_event.share_token,
      format: :pdf
    ) %>
    <div hidden data-turbo-temporary data-controller="open-url"
         data-open-url-url-value="https://wa.me/?text=<%= CGI.escape("#{mensagem} #{pdf_url}") %>"></div>
  <% end %>
<% end %>
