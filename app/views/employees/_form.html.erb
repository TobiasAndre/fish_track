<%= form_with model: @employee, class: "mt-6 space-y-4" do |f| %>
  <%= render "shared/form_errors", resource: @employee %>

  <div>
    <%= f.label :name, "Nome", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
    <%= f.text_field :name, autofocus: true,
      class: "w-full rounded-lg border px-3 py-2 text-sm
              bg-white dark:bg-gray-950
              border-gray-300 dark:border-gray-700
              text-gray-900 dark:text-gray-100
              focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div>
      <%= f.label :started_on, "Data de contratação", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.date_field :started_on, required: true,
        class: "w-full rounded-lg border px-3 py-2 text-sm
                bg-white dark:bg-gray-950
                border-gray-300 dark:border-gray-700
                text-gray-900 dark:text-gray-100
                focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :role, "Cargo (opcional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :role,
        class: "w-full rounded-lg border px-3 py-2 text-sm
                bg-white dark:bg-gray-950
                border-gray-300 dark:border-gray-700
                text-gray-900 dark:text-gray-100
                focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :unit_id, "Unidade (opcional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.collection_select :unit_id, @units || [], :id, :name,
        { include_blank: "Selecione uma unidade" },
        class: "w-full rounded-lg border px-3 py-2 text-sm
                bg-white dark:bg-gray-950
                border-gray-300 dark:border-gray-700
                text-gray-900 dark:text-gray-100
                focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :department, "Departamento (opcional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.text_field :department,
        class: "w-full rounded-lg border px-3 py-2 text-sm
                bg-white dark:bg-gray-950
                border-gray-300 dark:border-gray-700
                text-gray-900 dark:text-gray-100
                focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= f.label :status, "Status", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
      <%= f.select :status,
        Employee.statuses.keys.map { |s| [Employee.new(status: s).human_status, s] },
        {},
        class: "w-full rounded-lg border px-3 py-2 text-sm
                bg-white dark:bg-gray-950
                border-gray-300 dark:border-gray-700
                text-gray-900 dark:text-gray-100
                focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= f.label :terminated_on, "Data de desligamento (se aplicável)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
    <%= f.date_field :terminated_on,
      class: "w-full rounded-lg border px-3 py-2 text-sm
              bg-white dark:bg-gray-950
              border-gray-300 dark:border-gray-700
              text-gray-900 dark:text-gray-100
              focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <% if @employee.new_record? %>
    <div data-controller="money-input">
      <%= f.label :salary_cents, "Salário base (R$)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>

      <input
        type="text"
        inputmode="decimal"
        autocomplete="off"
        placeholder="Ex: 4.500,00"
        data-money-input-target="display"
        data-action="input->money-input#input blur->money-input#blur"
        class="w-full rounded-lg border px-3 py-2 text-sm
              bg-white dark:bg-gray-950
              border-gray-300 dark:border-gray-700
              text-gray-900 dark:text-gray-100
              focus:outline-none focus:ring-2 focus:ring-indigo-500" />

      <%= f.hidden_field :salary_cents, data: { "money-input-target": "cents" } %>
    </div>
  <% else %>
    <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/40 px-3 py-2 text-sm text-gray-600 dark:text-gray-300">
      O salário atual é
      <strong><%= number_to_currency(@employee.salary_cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %></strong>.
      Para alterá-lo, registre uma nova alteração salarial na página do funcionário — assim o histórico fica preservado.
    </div>
  <% end %>

  <div>
    <%= f.label :notes, "Observações (opcional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
    <%= f.text_area :notes, rows: 2,
      class: "w-full rounded-lg border px-3 py-2 text-sm
              bg-white dark:bg-gray-950
              border-gray-300 dark:border-gray-700
              text-gray-900 dark:text-gray-100
              focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit "Salvar",
      class: "flex-1 bg-indigo-600 hover:bg-indigo-700
              dark:bg-indigo-500 dark:hover:bg-indigo-400
              text-white font-medium py-2.5 rounded-lg transition" %>

    <%= link_to "Cancelar", employees_path,
      class: "px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-700
              hover:bg-gray-50 dark:hover:bg-gray-800 transition" %>
  </div>
<% end %>
