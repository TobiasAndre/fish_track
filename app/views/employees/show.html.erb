<div class="max-w-5xl mx-auto space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <%= link_to "&larr; Funcionários".html_safe, employees_path,
        class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" %>
      <h1 class="mt-1 text-2xl font-semibold text-gray-900 dark:text-gray-100"><%= @employee.name %></h1>
    </div>

    <div class="flex gap-2">
      <% if @employee.terminated? && @employee.terminated_on.present? %>
        <%= link_to "Acerto rescisório", termination_report_employee_path(@employee),
          target: "_blank", rel: "noopener",
          class: "px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                  hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
      <% end %>

      <%= link_to "Editar cadastro", edit_employee_path(@employee),
        class: "px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700
                hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
    </div>
  </div>

  <% if @alerts.any? %>
    <div class="space-y-2">
      <% @alerts.each do |alert| %>
        <% severity_classes = {
             info: "border-sky-200 bg-sky-50 text-sky-800 dark:border-sky-900 dark:bg-sky-950/40 dark:text-sky-300",
             warning: "border-amber-200 bg-amber-50 text-amber-800 dark:border-amber-900 dark:bg-amber-950/40 dark:text-amber-300",
             danger: "border-red-200 bg-red-50 text-red-800 dark:border-red-900 dark:bg-red-950/40 dark:text-red-300"
           }.fetch(alert.severity, "border-gray-200 bg-gray-50 text-gray-800") %>

        <div class="rounded-lg border px-4 py-3 text-sm <%= severity_classes %>">
          <p class="font-medium"><%= alert.title %></p>
          <p class="mt-0.5"><%= alert.message %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
    <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">Resumo</h2>

    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
      <div>
        <dt class="text-gray-500 dark:text-gray-400">Cargo</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= @employee.role.presence || "—" %></dd>
      </div>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Departamento</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= @employee.department.presence || "—" %></dd>
      </div>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Unidade</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= @employee.unit&.name || "—" %></dd>
      </div>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Status</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= @employee.human_status %></dd>
      </div>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Data de contratação</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100">
          <%= @employee.started_on.present? ? l(@employee.started_on) : "—" %>
        </dd>
      </div>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Tempo de empresa</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= @employee.employment_duration_label %></dd>
      </div>

      <% if @employee.terminated_on.present? %>
        <div>
          <dt class="text-gray-500 dark:text-gray-400">Data de desligamento</dt>
          <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100"><%= l(@employee.terminated_on) %></dd>
        </div>
      <% end %>

      <div>
        <dt class="text-gray-500 dark:text-gray-400">Salário atual</dt>
        <dd class="mt-0.5 font-medium text-gray-900 dark:text-gray-100">
          <%= number_to_currency(@employee.salary_cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
        </dd>
      </div>
    </dl>

    <% if @employee.notes.present? %>
      <div class="mt-4 pt-4 border-t border-gray-200 dark:border-gray-800 text-sm">
        <p class="text-gray-500 dark:text-gray-400 mb-1">Observações</p>
        <p class="text-gray-700 dark:text-gray-200"><%= simple_format(@employee.notes) %></p>
      </div>
    <% end %>
  </div>

  <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
    <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">Histórico salarial</h2>

    <% if @salary_changes.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800 text-left text-gray-500 dark:text-gray-400">
              <th class="py-2 pr-4 font-medium">Vigência</th>
              <th class="py-2 pr-4 font-medium">Salário anterior</th>
              <th class="py-2 pr-4 font-medium">Novo salário</th>
              <th class="py-2 pr-4 font-medium">Tipo</th>
              <th class="py-2 pr-4 font-medium">Motivo</th>
              <th class="py-2 pr-4 font-medium">Responsável</th>
            </tr>
          </thead>

          <tbody>
            <% @salary_changes.each do |change| %>
              <tr class="border-b border-gray-100 dark:border-gray-800">
                <td class="py-2 pr-4"><%= l(change.effective_on) %></td>
                <td class="py-2 pr-4">
                  <%= change.previous_salary_cents.present? ? number_to_currency(change.previous_salary_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") : "—" %>
                </td>
                <td class="py-2 pr-4 font-medium text-gray-900 dark:text-gray-100">
                  <%= number_to_currency(change.salary_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                </td>
                <td class="py-2 pr-4"><%= change.human_change_type %></td>
                <td class="py-2 pr-4"><%= change.reason.presence || "—" %></td>
                <td class="py-2 pr-4"><%= change.created_by&.name || "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-gray-400">Nenhuma alteração salarial registrada.</p>
    <% end %>

    <details class="mt-4">
      <summary class="cursor-pointer text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
        Registrar alteração salarial
      </summary>

      <%= form_with model: @new_salary_change, url: employee_salary_changes_path(@employee), local: true,
            class: "mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 items-end" do |f| %>
        <div data-controller="money-input">
          <%= f.label :salary_cents, "Novo salário (R$)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>

          <input type="text" inputmode="decimal" autocomplete="off" placeholder="Ex: 4.500,00"
            data-money-input-target="display"
            data-action="input->money-input#input blur->money-input#blur"
            class="w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" />

          <%= f.hidden_field :salary_cents, data: { "money-input-target": "cents" } %>
        </div>

        <div>
          <%= f.label :effective_on, "Data de vigência", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.date_field :effective_on, required: true,
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :change_type, "Tipo", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.select :change_type,
            EmployeeSalaryChange::CHANGE_TYPES.map { |t| [EmployeeSalaryChange.new(change_type: t).human_change_type, t] },
            {},
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :reason, "Motivo (opcional)", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.text_field :reason,
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="sm:col-span-2">
          <%= f.submit "Registrar alteração",
            class: "px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white text-sm font-medium transition" %>
        </div>
      <% end %>
    </details>
  </div>

  <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4">
    <h2 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">Férias</h2>

    <% if @vacations.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800 text-left text-gray-500 dark:text-gray-400">
              <th class="py-2 pr-4 font-medium">Período aquisitivo</th>
              <th class="py-2 pr-4 font-medium">Situação</th>
              <th class="py-2 pr-4 font-medium">Programado</th>
              <th class="py-2 pr-4 font-medium">Realizado</th>
              <th class="py-2 pr-4 font-medium">Dias</th>
              <th class="py-2 pr-4 font-medium">Pagamento</th>
              <th class="py-2 pr-4 font-medium text-right">Ações</th>
            </tr>
          </thead>

          <tbody>
            <% @vacations.each do |vacation| %>
              <tr class="border-b border-gray-100 dark:border-gray-800">
                <td class="py-2 pr-4">
                  <%= l(vacation.accrual_started_on) %> – <%= l(vacation.accrual_ended_on) %>
                </td>
                <td class="py-2 pr-4"><%= vacation.human_status %></td>
                <td class="py-2 pr-4">
                  <% if vacation.scheduled_start_on.present? %>
                    <%= l(vacation.scheduled_start_on) %> – <%= l(vacation.scheduled_end_on) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="py-2 pr-4">
                  <% if vacation.taken_start_on.present? %>
                    <%= l(vacation.taken_start_on) %> – <%= l(vacation.taken_end_on) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="py-2 pr-4"><%= vacation.taken_days %>/<%= vacation.entitled_days %></td>
                <td class="py-2 pr-4">
                  <% if vacation.paid_on.present? %>
                    Pago em <%= l(vacation.paid_on) %>
                  <% elsif vacation.payment_due_on.present? %>
                    Vence em <%= l(vacation.payment_due_on) %>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="py-2 pr-4 text-right">
                  <details>
                    <summary class="cursor-pointer text-indigo-600 dark:text-indigo-400 hover:underline">Editar</summary>

                    <%= form_with model: vacation, url: employee_vacation_path(@employee, vacation), local: true,
                          class: "mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 items-end text-left" do |f| %>
                      <div>
                        <%= f.label :status, "Situação", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.select :status,
                          EmployeeVacation::STATUSES.map { |s| [EmployeeVacation.new(status: s).human_status, s] },
                          {},
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :entitled_days, "Dias disponíveis", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.number_field :entitled_days, min: 0,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :scheduled_start_on, "Início programado", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :scheduled_start_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :scheduled_end_on, "Fim programado", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :scheduled_end_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :taken_start_on, "Início realizado", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :taken_start_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :taken_end_on, "Fim realizado", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :taken_end_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :taken_days, "Dias utilizados", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.number_field :taken_days, min: 0,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div data-controller="money-input">
                        <%= f.label :payment_amount_cents, "Valor do pagamento (R$)", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <input type="text" inputmode="decimal" autocomplete="off"
                          value="<%= vacation.payment_amount_cents.present? ? number_to_currency(vacation.payment_amount_cents / 100.0, unit: "", separator: ",", delimiter: ".") : "" %>"
                          data-money-input-target="display"
                          data-action="input->money-input#input blur->money-input#blur"
                          class="w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" />
                        <%= f.hidden_field :payment_amount_cents, data: { "money-input-target": "cents" } %>
                      </div>

                      <div>
                        <%= f.label :payment_due_on, "Vencimento do pagamento", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :payment_due_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div>
                        <%= f.label :paid_on, "Data do pagamento", class: "block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1" %>
                        <%= f.date_field :paid_on,
                          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
                      </div>

                      <div class="sm:col-span-2">
                        <%= f.submit "Salvar alterações",
                          class: "px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white text-sm font-medium transition" %>
                      </div>
                    <% end %>
                  </details>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 dark:text-gray-400">Nenhum período de férias cadastrado.</p>
    <% end %>

    <details class="mt-4">
      <summary class="cursor-pointer text-sm font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
        Cadastrar período de férias
      </summary>

      <%= form_with model: @new_vacation, url: employee_vacations_path(@employee), local: true,
            class: "mt-3 grid grid-cols-1 sm:grid-cols-2 gap-3 items-end" do |f| %>
        <div>
          <%= f.label :accrual_started_on, "Início do período aquisitivo", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.date_field :accrual_started_on, required: true,
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :accrual_ended_on, "Fim do período aquisitivo", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.date_field :accrual_ended_on, required: true,
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :status, "Situação", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.select :status,
            EmployeeVacation::STATUSES.map { |s| [EmployeeVacation.new(status: s).human_status, s] },
            {},
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= f.label :entitled_days, "Dias disponíveis", class: "block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1" %>
          <%= f.number_field :entitled_days, min: 0, value: 30,
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div class="sm:col-span-2">
          <%= f.submit "Cadastrar período",
            class: "px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-400 text-white text-sm font-medium transition" %>
        </div>
      <% end %>
    </details>
  </div>
</div>
