<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">
      Relatorio de Carregamentos
    </h1>

    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Consulte os carregamentos lançados, filtrando por período, produtor, cliente, lote e tanque.
    </p>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
    <%= form_with url: loading_reports_path, method: :get, local: true do %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <%= label_tag :start_date, "Data inicial", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= date_field_tag :start_date, params[:start_date],
                class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= label_tag :end_date, "Data final", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= date_field_tag :end_date, params[:end_date],
                class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= label_tag :integrated_id, "Produtor (Integrado)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= select_tag :integrated_id,
              options_from_collection_for_select(@integrateds, :id, :name, params[:integrated_id]),
              include_blank: "Todos",
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= label_tag :customer_id, "Cliente", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= select_tag :customer_id,
              options_from_collection_for_select(@customers, :id, :name, params[:customer_id]),
              include_blank: "Todos",
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= label_tag :batch_id, "Lote", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= select_tag :batch_id,
              options_from_collection_for_select(@batches, :id, :name, params[:batch_id]),
              include_blank: "Todos",
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>

        <div>
          <%= label_tag :pond_id, "Tanque", class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1" %>
          <%= select_tag :pond_id,
              options_from_collection_for_select(@ponds, :id, :full_name, params[:pond_id]),
              include_blank: "Todos",
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 mt-6">
        <%= submit_tag "Filtrar",
              class: "inline-flex items-center px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium hover:bg-blue-700 cursor-pointer" %>

        <%= link_to "Limpar filtros",
              loading_reports_path,
              class: "inline-flex items-center px-4 py-2 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-200 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-700" %>

        <%= link_to "Gerar PDF",
              loading_reports_path(
                format: :pdf,
                start_date: params[:start_date],
                end_date: params[:end_date],
                integrated_id: params[:integrated_id],
                batch_id: params[:batch_id],
                pond_id: params[:pond_id],
                customer_id: params[:customer_id]
              ),
              target: "_blank",
              class: "inline-flex items-center px-4 py-2 rounded-lg bg-emerald-600 text-white text-sm font-medium hover:bg-emerald-700" %>
      </div>
    <% end %>

    <%= form_with url: create_share_loading_reports_path, method: :post, local: true, class: "mt-3" do %>
      <%= hidden_field_tag :start_date, params[:start_date] %>
      <%= hidden_field_tag :end_date, params[:end_date] %>
      <%= hidden_field_tag :integrated_id, params[:integrated_id] %>
      <%= hidden_field_tag :batch_id, params[:batch_id] %>
      <%= hidden_field_tag :pond_id, params[:pond_id] %>
      <%= hidden_field_tag :customer_id, params[:customer_id] %>
      <button type="submit" title="Compartilhar no WhatsApp"
        class="inline-flex items-center justify-center rounded-lg bg-green-500 p-2 text-white hover:bg-green-600 transition">
        <i class="fa-brands fa-whatsapp text-xl"></i>
      </button>
    <% end %>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6 mb-8">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
        <div class="text-xs text-gray-500 dark:text-gray-400">Quantidade total</div>
        <div class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
          <%= number_with_delimiter(@total_quantity.to_i, delimiter: ".") %>
        </div>
      </div>

      <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
        <div class="text-xs text-gray-500 dark:text-gray-400">Peso total</div>
        <div class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
          <%= number_with_precision(@total_weight_kg.to_f, precision: 3, separator: ",", delimiter: ".") %> kg
        </div>
      </div>

      <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4">
        <div class="text-xs text-gray-500 dark:text-gray-400">Valor total</div>
        <div class="mt-1 text-lg font-semibold text-gray-900 dark:text-gray-100">
          <%= number_to_currency(@total_cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-white dark:bg-gray-900 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 p-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Carregamentos</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= @events.size %> carregamento(s) encontrado(s)</p>
      </div>
    </div>

    <% brl = ->(cents) { number_to_currency(cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") } %>
    <% abbr = ->(str) { str.present? ? truncate(str.to_s, length: 10, omission: "") : "—" } %>

    <div class="overflow-x-auto">
      <table class="min-w-full text-xs">
        <thead class="bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
          <tr>
            <th class="px-2 py-2 text-left font-semibold whitespace-nowrap">Data</th>
            <th class="px-2 py-2 text-right font-semibold">Quant. (kg)</th>
            <th class="px-2 py-2 text-right font-semibold">Peixes</th>
            <th class="px-2 py-2 text-right font-semibold">Média (kg)</th>
            <th class="px-2 py-2 text-right font-semibold">Preço/kg</th>
            <th class="px-2 py-2 text-right font-semibold">Milheiro</th>
            <th class="px-2 py-2 text-right font-semibold">Preço (R$)</th>
            <th class="px-2 py-2 text-right font-semibold">Frete</th>
            <th class="px-2 py-2 text-right font-semibold">Carregamento</th>
            <th class="px-2 py-2 text-right font-semibold">Pagamento</th>
            <th class="px-2 py-2 text-left font-semibold">Tanque</th>
            <th class="px-2 py-2 text-left font-semibold">Repasse</th>
          </tr>
        </thead>

        <tbody>
          <% if @events.any? %>
            <% groups = @events
                 .group_by { |e| [e.customer&.name.presence || "Sem cliente", e.integrated&.name.presence] }
                 .sort_by { |(customer_name, producer_name), _| [customer_name, producer_name.to_s] } %>
            <% groups.each do |(customer_name, producer_name), group_events| %>
              <tr class="bg-gray-800 text-white">
                <td colspan="12" class="px-2 py-1.5 font-semibold"><%= [customer_name, producer_name].compact.join(" / ") %></td>
              </tr>

              <% group_weight_kg = 0.to_d %>
              <% group_fish = 0 %>
              <% group_payment_cents = 0 %>

              <% group_events.sort_by { |e| [e.occurred_on || Date.new(1900, 1, 1), e.id] }.each do |event| %>
                <% group_weight_kg += event.total_weight_kg.to_d %>
                <% group_fish += event.quantity.to_i %>
                <% group_payment_cents += event.total_cents.to_i %>

                <tr class="border-t border-gray-100 dark:border-gray-800 text-gray-700 dark:text-gray-300">
                  <td class="px-2 py-1.5 whitespace-nowrap"><%= event.occurred_on.present? ? l(event.occurred_on, format: "%d/%m/%y") : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.total_weight_kg.present? ? number_with_precision(event.total_weight_kg, precision: 2, separator: ",", delimiter: ".") : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.quantity.present? ? number_with_delimiter(event.quantity, delimiter: ".") : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.avg_weight_g.present? ? number_with_precision(event.avg_weight_g.to_d / 1000, precision: 3, separator: ",", delimiter: ".") : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.price_per_kg_cents.to_i.positive? ? brl.call(event.price_per_kg_cents) : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.thousand_value_cents.to_i.positive? ? brl.call(event.thousand_value_cents) : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.effective_thousand_price_cents.positive? ? brl.call(event.effective_thousand_price_cents) : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.freight_cost_cents.to_i.positive? ? brl.call(event.freight_cost_cents) : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.loading_cost_cents.to_i.positive? ? brl.call(event.loading_cost_cents) : "—" %></td>
                  <td class="px-2 py-1.5 text-right"><%= event.total_cents.to_i.positive? ? brl.call(event.total_cents) : "—" %></td>
                  <td class="px-2 py-1.5"><%= abbr.call(event.batch_stocking&.pond&.name) %></td>
                  <td class="px-2 py-1.5"><%= abbr.call(event.loading_destination) %></td>
                </tr>
              <% end %>

              <% group_suppliers = group_events.map { |e| e.supplier&.name }.compact.uniq.map { |name| abbr.call(name) }.join(" / ") %>
              <tr class="bg-gray-100 dark:bg-gray-800 font-semibold text-gray-800 dark:text-gray-100">
                <td class="px-2 py-1.5">TOTAL</td>
                <td class="px-2 py-1.5 text-right"><%= number_with_precision(group_weight_kg, precision: 2, separator: ",", delimiter: ".") %></td>
                <td class="px-2 py-1.5 text-right"><%= number_with_delimiter(group_fish, delimiter: ".") %></td>
                <td class="px-2 py-1.5 text-right"><%= group_fish.positive? ? number_with_precision(group_weight_kg / group_fish, precision: 3, separator: ",", delimiter: ".") : "—" %></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td class="px-2 py-1.5 text-right"><%= brl.call(group_payment_cents) %></td>
                <td></td>
                <td class="px-2 py-1.5"><%= group_suppliers.presence || "—" %></td>
              </tr>
            <% end %>

            <% all_suppliers = @events.map { |e| e.supplier&.name }.compact.uniq.map { |name| abbr.call(name) }.join(" / ") %>
            <tr class="bg-gray-200 dark:bg-gray-700 font-semibold text-gray-900 dark:text-gray-50">
              <td class="px-2 py-1.5">GERAL</td>
              <td class="px-2 py-1.5 text-right"><%= number_with_precision(@total_weight_kg.to_d, precision: 2, separator: ",", delimiter: ".") %></td>
              <td class="px-2 py-1.5 text-right"><%= number_with_delimiter(@total_quantity.to_i, delimiter: ".") %></td>
              <td class="px-2 py-1.5 text-right"><%= @total_quantity.to_i.positive? ? number_with_precision(@total_weight_kg.to_d / @total_quantity.to_i, precision: 3, separator: ",", delimiter: ".") : "—" %></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td></td>
              <td class="px-2 py-1.5 text-right"><%= brl.call(@total_cents) %></td>
              <td></td>
              <td class="px-2 py-1.5"><%= all_suppliers.presence || "—" %></td>
            </tr>
          <% else %>
            <tr>
              <td colspan="12" class="px-4 py-8 text-center text-gray-500 dark:text-gray-400">
                Nenhum carregamento encontrado para os filtros selecionados.
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if params[:report_share_id].present? && session[:tenant_name].present? %>
    <% report_share = ReportShare.find_by(id: params[:report_share_id], report_type: "loading_report") %>
    <% if report_share.present? %>
      <% company = Company.find_by(tenant_name: session[:tenant_name]) %>
      <% mensagem = "Relatório de Carregamentos #{company&.name}" %>
      <% pdf_url = shared_loading_report_pdf_url(
        tenant_name: session[:tenant_name],
        id: report_share.id,
        share_token: report_share.share_token,
        format: :pdf
      ) %>
      <script>
        window.open("<%= j whatsapp_share_url(message: mensagem, url: pdf_url) %>", "_blank");
      </script>
    <% end %>
  <% end %>
</div>
