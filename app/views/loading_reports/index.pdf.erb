<style>
  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 9px;
    color: #111;
    background: #fff;
  }

  .header {
    border-bottom: 2px solid #222;
    padding-bottom: 8px;
    margin-bottom: 14px;
  }

  .title {
    font-size: 17px;
    font-weight: bold;
    margin: 0;
  }

  .subtitle {
    font-size: 10px;
    color: #555;
    margin-top: 4px;
  }

  .section-title {
    font-size: 12px;
    font-weight: bold;
    margin: 14px 0 6px;
    padding-bottom: 3px;
    border-bottom: 1px solid #ccc;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
  }

  th {
    background: #f0f0f0;
    border: 1px solid #bbb;
    padding: 3px 4px;
    text-align: left;
    font-weight: bold;
  }

  td {
    border: 1px solid #ccc;
    padding: 3px 4px;
    vertical-align: top;
  }

  .text-right {
    text-align: right;
  }

  .loadings tbody tr {
    page-break-inside: avoid;
  }

  /* Coluna "Data": encolhe até o conteúdo e sobra espaço para as demais. */
  .loadings th:first-child,
  .loadings td:first-child {
    width: 1%;
    white-space: nowrap;
  }

  .loadings tr.group-title td {
    background: #333;
    color: #fff;
    font-weight: bold;
    font-size: 10px;
  }

  /* Espaço em branco entre um grupo e o próximo. */
  .loadings tr.group-spacer td {
    border: none;
    background: #fff;
    padding: 0;
    height: 8px;
  }

  .loadings tr.group-total td {
    background: #eee;
    font-weight: bold;
  }

  .loadings tr.grand-total td {
    background: #ccc;
    font-weight: bold;
  }

  .empty {
    text-align: center;
    color: #777;
    padding: 18px;
  }

  .footer {
    margin-top: 18px;
    padding-top: 6px;
    border-top: 1px solid #ccc;
    font-size: 8px;
    color: #666;
  }
</style>

<% brl = ->(cents) { number_to_currency(cents.to_i / 100.0, unit: "R$ ", separator: ",", delimiter: ".") } %>
<% abbr = ->(str) { str.present? ? truncate(str.to_s, length: 10, omission: "") : "-" } %>

<div class="header">
  <h1 class="title">Relatorio de Carregamentos</h1>

  <div class="subtitle">
    Gerado em <%= l(Date.current) %>
  </div>
</div>

<div class="section-title">Filtros utilizados</div>

<table>
  <tbody>
    <tr>
      <th scope="row">Data inicial</th>
      <td><%= params[:start_date].presence || "-" %></td>

      <th scope="row">Data final</th>
      <td><%= params[:end_date].presence || "-" %></td>

      <th scope="row">Produtor</th>
      <td><%= @integrateds.find_by(id: params[:integrated_id])&.name || "Todos" %></td>
    </tr>

    <tr>
      <th scope="row">Lote</th>
      <td><%= @batches.find_by(id: params[:batch_id])&.name || "Todos" %></td>

      <th scope="row">Tanque</th>
      <td><%= @ponds.find_by(id: params[:pond_id])&.name || "Todos" %></td>

      <th scope="row">Cliente</th>
      <td><%= @customers.find_by(id: params[:customer_id])&.name || "Todos" %></td>
    </tr>
  </tbody>
</table>

<div class="section-title">Carregamentos</div>

<table class="loadings">
  <thead>
    <tr>
      <th>Data</th>
      <th class="text-right">Quant. (kg)</th>
      <th class="text-right">Peixes</th>
      <th class="text-right">Média (kg)</th>
      <th class="text-right">Preço/kg</th>
      <th class="text-right">Milheiro</th>
      <th class="text-right">Preço (R$)</th>
      <th class="text-right">Frete</th>
      <th class="text-right">Carregamento</th>
      <th class="text-right">Pagamento</th>
      <th>Tanque</th>
      <th>Repasse</th>
    </tr>
  </thead>

  <tbody>
    <% if @events.any? %>
      <% groups = @events
           .group_by { |e| [e.customer&.name.presence || "Sem cliente", e.integrated&.name.presence] }
           .sort_by { |(customer_name, producer_name), _| [customer_name, producer_name.to_s] } %>
      <% groups.each_with_index do |((customer_name, producer_name), group_events), group_index| %>
        <% if group_index.positive? %>
          <tr class="group-spacer"><td colspan="12"></td></tr>
        <% end %>

        <tr class="group-title">
          <td colspan="12"><%= [customer_name, producer_name].compact.join(" / ") %></td>
        </tr>

        <% group_weight_kg = 0.to_d %>
        <% group_fish = 0 %>
        <% group_payment_cents = 0 %>
        <% group_freight_cents = 0 %>
        <% group_loading_cents = 0 %>

        <% group_events.sort_by { |e| [e.occurred_on || Date.new(1900, 1, 1), e.id] }.each do |event| %>
          <% group_weight_kg += event.total_weight_kg.to_d %>
          <% group_fish += event.quantity.to_i %>
          <% group_payment_cents += event.total_cents.to_i %>
          <% group_freight_cents += event.freight_cost_cents.to_i %>
          <% group_loading_cents += event.loading_cost_cents.to_i %>

          <tr>
            <td><%= event.occurred_on.present? ? l(event.occurred_on, format: "%d/%m/%y") : "-" %></td>
            <td class="text-right"><%= event.total_weight_kg.present? ? number_with_precision(event.total_weight_kg, precision: 2, separator: ",", delimiter: ".") : "-" %></td>
            <td class="text-right"><%= event.quantity.present? ? number_with_delimiter(event.quantity, delimiter: ".") : "-" %></td>
            <td class="text-right"><%= event.avg_weight_g.present? ? number_with_precision(event.avg_weight_g.to_d / 1000, precision: 3, separator: ",", delimiter: ".") : "-" %></td>
            <td class="text-right"><%= event.price_per_kg_cents.to_i.positive? ? brl.call(event.price_per_kg_cents) : "-" %></td>
            <td class="text-right"><%= event.thousand_value_cents.to_i.positive? ? brl.call(event.thousand_value_cents) : "-" %></td>
            <td class="text-right"><%= event.effective_thousand_price_cents.positive? ? brl.call(event.effective_thousand_price_cents) : "-" %></td>
            <td class="text-right"><%= event.freight_cost_cents.to_i.positive? ? brl.call(event.freight_cost_cents) : "-" %></td>
            <td class="text-right"><%= event.loading_cost_cents.to_i.positive? ? brl.call(event.loading_cost_cents) : "-" %></td>
            <td class="text-right"><%= event.total_cents.to_i.positive? ? brl.call(event.total_cents) : "-" %></td>
            <td><%= abbr.call(event.batch_stocking&.pond&.name) %></td>
            <td><%= abbr.call(event.loading_destination) %></td>
          </tr>
        <% end %>

        <% group_suppliers = group_events.map { |e| e.supplier&.name }.compact.uniq.map { |name| abbr.call(name) }.join(" / ") %>
        <tr class="group-total">
          <td>TOTAL</td>
          <td class="text-right"><%= number_with_precision(group_weight_kg, precision: 2, separator: ",", delimiter: ".") %></td>
          <td class="text-right"><%= number_with_delimiter(group_fish, delimiter: ".") %></td>
          <td class="text-right"><%= group_fish.positive? ? number_with_precision(group_weight_kg / group_fish, precision: 3, separator: ",", delimiter: ".") : "-" %></td>
          <td></td>
          <td></td>
          <td></td>
          <td class="text-right"><%= brl.call(group_freight_cents) %></td>
          <td class="text-right"><%= brl.call(group_loading_cents) %></td>
          <td class="text-right"><%= brl.call(group_payment_cents) %></td>
          <td></td>
          <td><%= group_suppliers.presence || "-" %></td>
        </tr>
      <% end %>

      <% all_suppliers = @events.map { |e| e.supplier&.name }.compact.uniq.map { |name| abbr.call(name) }.join(" / ") %>
      <tr class="grand-total">
        <td>GERAL</td>
        <td class="text-right"><%= number_with_precision(@total_weight_kg.to_d, precision: 2, separator: ",", delimiter: ".") %></td>
        <td class="text-right"><%= number_with_delimiter(@total_quantity.to_i, delimiter: ".") %></td>
        <td class="text-right"><%= @total_quantity.to_i.positive? ? number_with_precision(@total_weight_kg.to_d / @total_quantity.to_i, precision: 3, separator: ",", delimiter: ".") : "-" %></td>
        <td></td>
        <td></td>
        <td></td>
        <td class="text-right"><%= brl.call(@total_freight_cents) %></td>
        <td class="text-right"><%= brl.call(@total_loading_cents) %></td>
        <td class="text-right"><%= brl.call(@total_cents) %></td>
        <td></td>
        <td><%= all_suppliers.presence || "-" %></td>
      </tr>
    <% else %>
      <tr>
        <td colspan="12" class="empty">
          Nenhum carregamento encontrado para os filtros selecionados.
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="footer">
  Relatório gerado automaticamente pelo Fish Track.
</div>
