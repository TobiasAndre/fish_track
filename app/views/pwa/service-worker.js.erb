// Service worker do Fish Track.
//
// Objetivo: instalável no celular, carregar rápido e mostrar uma página de
// "sem conexão" em vez do erro do navegador. As páginas do app NUNCA são
// guardadas em cache: têm dados da empresa e do usuário logado (e tokens de
// formulário), então vêm sempre da rede -- não há dado stale nem vazamento em
// aparelho compartilhado depois do logout. Só ficam em cache os arquivos
// estáticos (assets versionados, ícones e a página offline).
//
// A exceção são as telas de campo (FIELD_PAGES, ex.: biometria em campo): são
// só a estrutura da tela, sem dados nem token (layout offline_app), e precisam
// abrir sem internet. Ficam em cache junto com os arquivos que usam; os dados
// que mostram vêm do próprio aparelho.
//
// A versão muda sozinha quando a página offline ou algum ícone mudam.
const VERSION = "<%= Digest::MD5.hexdigest(%w[offline.html icons/icon-192.png icons/icon-512.png icons/icon-maskable-512.png].map { |f| Rails.public_path.join(f).read(mode: "rb") }.join)[0, 12] %>"
const CACHE = `fishtrack-static-${VERSION}`
const OFFLINE_URL = "/offline.html"
const PRECACHE = [OFFLINE_URL, "/icons/icon-192.png", "/icons/icon-512.png", "/icons/icon-maskable-512.png"]
const FIELD_PAGES = ["/biometry_events/offline"]

self.addEventListener("install", (event) => {
  event.waitUntil(caches.open(CACHE).then((cache) => cache.addAll(PRECACHE)))
  self.skipWaiting()
})

self.addEventListener("activate", (event) => {
  event.waitUntil(
    caches.keys()
      .then((keys) => Promise.all(keys.filter((key) => key.startsWith("fishtrack-") && key !== CACHE).map((key) => caches.delete(key))))
      .then(() => self.clients.claim())
  )
})

self.addEventListener("fetch", (event) => {
  const request = event.request
  if (request.method !== "GET") return

  const url = new URL(request.url)
  if (url.origin !== self.location.origin) return

  if (request.mode === "navigate" && FIELD_PAGES.includes(url.pathname)) {
    event.respondWith(
      fetch(request)
        .then((response) => {
          // Só guarda a tela de verdade (sessão expirada redireciona para o login).
          if (response.ok && !response.redirected) {
            const copy = response.clone()
            caches.open(CACHE).then((cache) => cache.put(url.pathname, copy))
          }
          return response
        })
        .catch(() => caches.match(url.pathname).then((cached) => cached || caches.match(OFFLINE_URL)))
    )
    return
  }

  if (request.mode === "navigate") {
    event.respondWith(fetch(request).catch(() => caches.match(OFFLINE_URL)))
    return
  }

  // Assets versionados (nome com digest) e ícones: cache primeiro.
  if (url.pathname.startsWith("/assets/") || url.pathname.startsWith("/icons/")) {
    event.respondWith(
      caches.match(request).then((cached) => {
        if (cached) return cached

        return fetch(request).then((response) => {
          if (response.ok) {
            const copy = response.clone()
            caches.open(CACHE).then((cache) => cache.put(request, copy))
          }
          return response
        })
      })
    )
  }
})

// A tela de campo pede para guardar ela mesma e os arquivos que usa (CSS e
// módulos JS), para abrir sem internet já na próxima vez.
self.addEventListener("message", (event) => {
  if (event.data?.type !== "cache-field-page") return

  const urls = (event.data.urls || [])
    .map((value) => new URL(value, self.location.origin))
    .filter((url) => url.origin === self.location.origin &&
      (FIELD_PAGES.includes(url.pathname) || url.pathname.startsWith("/assets/") || url.pathname.startsWith("/icons/")))
    .map((url) => (FIELD_PAGES.includes(url.pathname) ? url.pathname : url.href))

  event.waitUntil(
    caches.open(CACHE)
      .then((cache) => Promise.all(urls.map((url) => {
        if (!FIELD_PAGES.includes(url)) return cache.add(url).catch(() => null)

        // A tela em si: só guarda se veio de verdade (sessão expirada redireciona para o login).
        return fetch(url, { credentials: "same-origin" })
          .then((response) => (response.ok && !response.redirected ? cache.put(url, response) : null))
          .catch(() => null)
      })))
      .then(() => event.source?.postMessage({ type: "field-page-cached" }))
  )
})
