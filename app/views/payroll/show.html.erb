<div class="max-w-6xl mx-auto">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Folha de pagamento</h1>
      <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
        Competência <%= "%02d" % @month %>/<%= @year %> — salário base + bônus - adiantamentos - descontos.
      </p>
    </div>

    <div class="flex items-end gap-2">
      <%= form_with url: payroll_path, method: :get, class: "flex items-end gap-2" do %>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Mês</label>
          <%= select_tag :month,
            options_for_select((1..12).map { |m| ["%02d" % m, m] }, @month),
            class: "rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950
                    border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Ano</label>
          <%= number_field_tag :year, @year,
            class: "w-28 rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950
                    border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100" %>
        </div>

        <%= submit_tag "Ir",
          class: "px-4 py-2 rounded-lg bg-gray-900 text-white hover:bg-gray-800
                  dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-200 transition" %>
      <% end %>
    </div>
  </div>

  <div class="mt-6 space-y-4">
    <% @employees.each do |emp| %>
      <% items = (@items_by_employee[emp.id] || []) %>
      <% advances = items.select { |i| i.item_type == "advance" } %>
      <% thirteenth_advances = items.select { |i| i.item_type == "thirteenth_advance" } %>
      <% bonuses = items.select { |i| i.item_type == "bonus" } %>
      <% discounts = items.select { |i| i.item_type == "discount" } %>
      <% salary_payment = items.find { |i| i.item_type == "salary_payment" } %>
      <% total_adv_cents = advances.sum(&:amount_cents) %>
      <% total_thirteenth_advance_cents = thirteenth_advances.sum(&:amount_cents) %>
      <% total_bonus_cents = bonuses.sum(&:amount_cents) %>
      <% total_discount_cents = discounts.sum(&:amount_cents) %>
      <% terminated_this_month = emp.terminated? && emp.terminated_on.present? && emp.terminated_on.year == @year && emp.terminated_on.month == @month %>
      <% salary_cents = terminated_this_month ? 0 : emp.salary_on(@competence_date).to_i %>
      <% remaining_cents = [salary_cents + total_bonus_cents - total_adv_cents - total_discount_cents, 0].max %>
      <% paid_cents = salary_payment&.amount_cents.to_i %>
      <% outstanding_cents = [remaining_cents - paid_cents, 0].max %>
      <% emp_alerts = EmployeeAlerts.new(emp, reference_date: @competence_date).call %>
      <% available_vacations = emp.vacations.where(status: "available") %>
      <% scheduled_vacations = emp.vacations.where(status: "scheduled") %>

      <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-200 dark:border-gray-800 flex items-start justify-between gap-4">
          <div>
            <div class="font-semibold text-gray-900 dark:text-gray-100">
              <%= link_to emp.name, employee_path(emp), class: "hover:underline" %>
            </div>
            <div class="text-xs text-gray-500 dark:text-gray-400"><%= emp.role.presence || "—" %></div>

            <div class="mt-1 flex flex-wrap gap-2">
              <% if emp.started_on.present? %>
                <span class="inline-flex items-center rounded-lg bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-[11px] text-gray-600 dark:text-gray-300">
                  Admissão: <%= l(emp.started_on) %>
                </span>
              <% end %>

              <span class="inline-flex items-center rounded-lg bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-[11px] text-gray-600 dark:text-gray-300">
                Tempo de empresa: <%= emp.employment_duration_label(reference_date: @competence_date) %>
              </span>

              <% if available_vacations.any? %>
                <span class="inline-flex items-center rounded-lg bg-sky-100 dark:bg-sky-950 px-2 py-0.5 text-[11px] text-sky-700 dark:text-sky-300">
                  Férias disponíveis
                </span>
              <% end %>

              <% if scheduled_vacations.any? %>
                <span class="inline-flex items-center rounded-lg bg-amber-100 dark:bg-amber-950 px-2 py-0.5 text-[11px] text-amber-700 dark:text-amber-300">
                  Férias programadas
                </span>
              <% end %>

              <% if emp_alerts.any? %>
                <%= link_to employee_path(emp),
                  title: emp_alerts.map { |a| "#{a.title}: #{a.message}" }.join("\n"),
                  class: "inline-flex items-center rounded-lg bg-red-100 dark:bg-red-950 px-2 py-0.5 text-[11px]
                          text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900 transition cursor-help" do %>
                  <%= emp_alerts.size %> alerta(s)
                <% end %>
              <% end %>
            </div>
          </div>

          <div class="text-right">
            <div class="text-xs text-gray-500 dark:text-gray-400">Saldo a pagar</div>
            <div class="text-lg font-semibold text-gray-900 dark:text-gray-100">
              <%= number_to_currency(outstanding_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
            </div>

            <% if salary_payment %>
              <div class="mt-1 text-[11px] text-emerald-600 dark:text-emerald-400">
                Pago em <%= l(salary_payment.occurred_on) %> —
                <%= number_to_currency(paid_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </div>
              <%= button_to "Estornar pagamento", payroll_item_path(salary_payment),
                method: :delete,
                data: { turbo_confirm: "Estornar o pagamento do salário? Isso também remove o lançamento do financeiro." },
                class: "mt-2 px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700
                        hover:bg-gray-50 dark:hover:bg-gray-800 transition text-xs font-medium" %>
            <% elsif remaining_cents > 0 %>
              <%= button_to "Marcar salário como pago", payroll_items_path,
                params: {
                  payroll_item: {
                    employee_id: emp.id, year: @year, month: @month, item_type: "salary_payment",
                    occurred_on: Date.current, amount_cents: remaining_cents,
                    notes: "Pagamento de salário #{"%02d" % @month}/#{@year}"
                  }
                },
                data: { turbo_confirm: "Marcar #{number_to_currency(remaining_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".")} como pago e lançar no financeiro?" },
                class: "mt-2 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700
                        dark:bg-emerald-500 dark:hover:bg-emerald-400 text-white text-xs font-medium transition" %>
            <% end %>
          </div>
        </div>

        <% if terminated_this_month %>
          <% settlement = Employees::TerminationSettlement.new(emp).call %>

          <div class="mx-4 mt-4 rounded-xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/30 p-4">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">
                Acerto rescisório — desligado em <%= l(emp.terminated_on) %>
              </h3>

              <%= link_to "Ver relatório", termination_report_employee_path(emp),
                target: "_blank", rel: "noopener",
                class: "text-xs text-amber-800 dark:text-amber-300 hover:underline" %>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
              <div class="rounded-lg bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900 p-3">
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  Saldo de salário (<%= settlement.days_worked_in_month %>/<%= settlement.days_in_month %> dias)
                </div>
                <div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
                  <%= number_to_currency(settlement.balance_salary_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                </div>
                <%= button_to "Lançar", payroll_items_path,
                  params: {
                    payroll_item: {
                      employee_id: emp.id, year: @year, month: @month, item_type: "bonus",
                      occurred_on: emp.terminated_on, amount_cents: settlement.balance_salary_cents,
                      notes: "Saldo de salário (acerto rescisório)"
                    }
                  },
                  class: "mt-2 w-full px-3 py-1.5 rounded-lg border border-amber-300 dark:border-amber-800 text-xs font-medium hover:bg-amber-100 dark:hover:bg-amber-900 transition" %>
              </div>

              <div class="rounded-lg bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900 p-3">
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  13º salário proporcional (<%= settlement.thirteenth_months %>/12)
                </div>
                <div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
                  <%= number_to_currency(settlement.thirteenth_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                </div>
                <%= button_to "Lançar", payroll_items_path,
                  params: {
                    payroll_item: {
                      employee_id: emp.id, year: @year, month: @month, item_type: "bonus",
                      occurred_on: emp.terminated_on, amount_cents: settlement.thirteenth_cents,
                      notes: "13º salário proporcional (acerto rescisório)"
                    }
                  },
                  class: "mt-2 w-full px-3 py-1.5 rounded-lg border border-amber-300 dark:border-amber-800 text-xs font-medium hover:bg-amber-100 dark:hover:bg-amber-900 transition" %>
              </div>

              <div class="rounded-lg bg-white dark:bg-gray-900 border border-amber-200 dark:border-amber-900 p-3">
                <div class="text-xs text-gray-500 dark:text-gray-400">
                  Férias proporcionais + 1/3 (<%= settlement.vacation_months %>/12)
                </div>
                <div class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
                  <%= number_to_currency(settlement.vacation_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                </div>
                <%= button_to "Lançar", payroll_items_path,
                  params: {
                    payroll_item: {
                      employee_id: emp.id, year: @year, month: @month, item_type: "bonus",
                      occurred_on: emp.terminated_on, amount_cents: settlement.vacation_cents,
                      notes: "Férias proporcionais + 1/3 (acerto rescisório)"
                    }
                  },
                  class: "mt-2 w-full px-3 py-1.5 rounded-lg border border-amber-300 dark:border-amber-800 text-xs font-medium hover:bg-amber-100 dark:hover:bg-amber-900 transition" %>
              </div>
            </div>

            <div class="mt-3 pt-3 border-t border-amber-200 dark:border-amber-900 flex items-center justify-between text-sm">
              <span class="font-medium text-amber-900 dark:text-amber-200">Total do acerto</span>
              <span class="font-semibold text-amber-900 dark:text-amber-200">
                <%= number_to_currency(settlement.total_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>
          </div>
        <% end %>

        <div class="p-4 grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
          <!-- Resumo -->
          <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-300">Salário base</span>
              <span class="font-medium text-gray-900 dark:text-gray-100">
                <%= number_to_currency(salary_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>

            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-300">Bônus</span>
              <span class="font-medium text-emerald-600 dark:text-emerald-400">
                + <%= number_to_currency(total_bonus_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>

            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-300">Adiantamentos</span>
              <span class="font-medium text-gray-900 dark:text-gray-100">
                <%= number_to_currency(total_adv_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>

            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-300" title="Adiantado contra o 13º salário — não entra no cálculo do mês, será descontado quando o 13º for pago">
                Adiantamento 13º
              </span>
              <span class="font-medium text-gray-900 dark:text-gray-100">
                <%= number_to_currency(total_thirteenth_advance_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>

            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm text-gray-600 dark:text-gray-300">Descontos</span>
              <span class="font-medium text-rose-600 dark:text-rose-400">
                - <%= number_to_currency(total_discount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>

            <% if paid_cents > 0 %>
              <div class="mt-2 flex items-center justify-between">
                <span class="text-sm text-gray-600 dark:text-gray-300">Pago</span>
                <span class="font-medium text-emerald-600 dark:text-emerald-400">
                  <%= number_to_currency(paid_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                </span>
              </div>
            <% end %>

            <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-800 flex items-center justify-between">
              <span class="text-sm font-medium text-gray-700 dark:text-gray-200">Falta pagar</span>
              <span class="font-semibold text-gray-900 dark:text-gray-100">
                <%= number_to_currency(outstanding_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
              </span>
            </div>
          </div>

          <!-- Lista de adiantamentos -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Adiantamentos</h3>
            </div>

            <div class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
              <div class="divide-y divide-gray-200 dark:divide-gray-800">
                <% if advances.any? %>
                  <% advances.each do |a| %>
                    <div class="px-4 py-3 flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
                          <%= number_to_currency(a.amount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                          <%= a.notes.presence || "Adiantamento" %>
                          <% if a.installment_number && a.installments_count %>
                            <span class="inline-flex items-center rounded bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 ml-1 text-[11px]">
                              parcela <%= a.installment_number %>/<%= a.installments_count %>
                            </span>
                          <% end %>
                        </div>
                      </div>

                      <%= button_to "Remover", payroll_item_path(a),
                        method: :delete,
                        data: { turbo_confirm: "Remover este adiantamento?" },
                        class: "px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700
                                hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400">
                    Nenhum adiantamento lançado neste mês.
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Lista de adiantamentos de 13º -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Adiantamento 13º</h3>
            </div>

            <div class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
              <div class="divide-y divide-gray-200 dark:divide-gray-800">
                <% if thirteenth_advances.any? %>
                  <% thirteenth_advances.each do |a| %>
                    <div class="px-4 py-3 flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
                          <%= number_to_currency(a.amount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                          <%= a.notes.presence || "Adiantamento 13º" %>
                          <% if a.installment_number && a.installments_count %>
                            <span class="inline-flex items-center rounded bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 ml-1 text-[11px]">
                              parcela <%= a.installment_number %>/<%= a.installments_count %>
                            </span>
                          <% end %>
                        </div>
                      </div>

                      <%= button_to "Remover", payroll_item_path(a),
                        method: :delete,
                        data: { turbo_confirm: "Remover este adiantamento de 13º?" },
                        class: "px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700
                                hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400">
                    Nenhum adiantamento de 13º lançado neste mês.
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Lista de bônus -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Bônus</h3>
            </div>

            <div class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
              <div class="divide-y divide-gray-200 dark:divide-gray-800">
                <% if bonuses.any? %>
                  <% bonuses.each do |b| %>
                    <div class="px-4 py-3 flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
                          + <%= number_to_currency(b.amount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                          <%= b.notes.presence || "Bônus" %>
                        </div>
                      </div>

                      <%= button_to "Remover", payroll_item_path(b),
                        method: :delete,
                        data: { turbo_confirm: "Remover este bônus?" },
                        class: "px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700
                                hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400">
                    Nenhum valor extra lançado neste mês.
                  </div>
                <% end %>
              </div>
            </div>
          </div>

          <!-- Lista de descontos -->
          <div>
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Descontos</h3>
            </div>

            <div class="rounded-xl border border-gray-200 dark:border-gray-800 overflow-hidden">
              <div class="divide-y divide-gray-200 dark:divide-gray-800">
                <% if discounts.any? %>
                  <% discounts.each do |d| %>
                    <div class="px-4 py-3 flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <div class="text-sm font-medium text-rose-600 dark:text-rose-400">
                          - <%= number_to_currency(d.amount_cents / 100.0, unit: "R$ ", separator: ",", delimiter: ".") %>
                        </div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                          <%= d.notes.presence || "Desconto" %>
                        </div>
                      </div>

                      <%= button_to "Remover", payroll_item_path(d),
                        method: :delete,
                        data: { turbo_confirm: "Remover este desconto?" },
                        class: "px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-700
                                hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm" %>
                    </div>
                  <% end %>
                <% else %>
                  <div class="px-4 py-6 text-sm text-gray-500 dark:text-gray-400">
                    Nenhum desconto lançado neste mês.
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <!-- Form: novo lançamento -->
        <div class="px-4 pb-4">
          <div class="rounded-xl border border-gray-200 dark:border-gray-800 p-4 bg-gray-50 dark:bg-gray-950/30">
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-3">Novo lançamento</h3>

            <%= form_with model: @new_item, url: payroll_items_path, method: :post, class: "grid grid-cols-1 sm:grid-cols-6 gap-3 items-end" do |f| %>
              <%= f.hidden_field :employee_id, value: emp.id %>
              <%= f.hidden_field :year, value: @year %>
              <%= f.hidden_field :month, value: @month %>

              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Tipo</label>
                <%= f.select :item_type,
                  [["Adiantamento", "advance"], ["Adiantamento 13º", "thirteenth_advance"], ["Bônus", "bonus"], ["Desconto", "discount"]],
                  {},
                  class: "w-full rounded-lg border px-3 py-2 text-sm
                          bg-white dark:bg-gray-950
                          border-gray-300 dark:border-gray-700
                          text-gray-900 dark:text-gray-100" %>
              </div>

              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Data de lançamento</label>
                <%= f.date_field :occurred_on, value: @competence_date,
                  class: "w-full rounded-lg border px-3 py-2 text-sm
                          bg-white dark:bg-gray-950
                          border-gray-300 dark:border-gray-700
                          text-gray-900 dark:text-gray-100" %>
              </div>

              <div data-controller="money-input">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Valor (R$)</label>

                <input
                  type="text"
                  inputmode="decimal"
                  autocomplete="off"
                  placeholder="Ex: 1.500,00"
                  data-money-input-target="display"
                  data-action="input->money-input#input blur->money-input#blur"
                  class="w-full rounded-lg border px-3 py-2 text-sm
                         bg-white dark:bg-gray-950
                         border-gray-300 dark:border-gray-700
                         text-gray-900 dark:text-gray-100" />

                <%= f.hidden_field :amount_cents, data: { "money-input-target": "cents" } %>
              </div>

              <div>
                <label for="installments_count_<%= emp.id %>" class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Parcelas</label>
                <input
                  type="number"
                  id="installments_count_<%= emp.id %>"
                  name="installments_count"
                  min="1"
                  max="36"
                  value="1"
                  title="Só se aplica a adiantamentos (normal ou de 13º): divide o valor em N meses consecutivos a partir da data de lançamento"
                  class="w-full rounded-lg border px-3 py-2 text-sm
                         bg-white dark:bg-gray-950
                         border-gray-300 dark:border-gray-700
                         text-gray-900 dark:text-gray-100" />
              </div>

              <div class="sm:col-span-2">
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-200 mb-1">Observação</label>
                <%= f.text_field :notes, placeholder: "Ex: adiantamento para compra de insumos…",
                  class: "w-full rounded-lg border px-3 py-2 text-sm
                          bg-white dark:bg-gray-950
                          border-gray-300 dark:border-gray-700
                          text-gray-900 dark:text-gray-100" %>
              </div>

              <div class="sm:col-span-6">
                <%= f.submit "Lançar",
                  class: "w-full px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700
                          dark:bg-indigo-500 dark:hover:bg-indigo-400
                          text-white text-sm font-medium transition" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @employees.empty? %>
      <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 text-sm text-gray-500 dark:text-gray-400">
        Nenhum funcionário cadastrado.
        <%= link_to "Criar funcionário", new_employee_path, class: "text-indigo-600 dark:text-indigo-400 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>
