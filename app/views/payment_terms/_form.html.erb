<%= form_with model: @payment_term, local: true do |form| %>
  <div class="space-y-6">
    <% if @payment_term.errors.any? %>
      <div class="rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700 dark:border-red-800 dark:bg-red-950 dark:text-red-300">
        <p class="font-semibold mb-2">Não foi possível salvar a condição de pagamento:</p>
        <ul class="list-disc pl-5 space-y-1">
          <% @payment_term.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Nome", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <div class="mt-1">
        <%= form.text_field :name,
          class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <fieldset class="rounded-lg border border-gray-200 dark:border-gray-800 p-4 space-y-4">
      <legend class="px-1 text-sm font-medium text-gray-700 dark:text-gray-300">Parcelamento</legend>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <%= form.label :days, "1ª parcela (dias)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <div class="mt-1">
            <%= form.text_field :days,
              inputmode: "numeric",
              placeholder: "Ex.: 30",
              data: { controller: "digits", action: "input->digits#strip" },
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Dias a partir da data do lançamento. Em branco / 0 = à vista.</p>
        </div>

        <div>
          <%= form.label :installments_count, "Nº de parcelas", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <div class="mt-1">
            <%= form.text_field :installments_count,
              inputmode: "numeric",
              placeholder: "1",
              data: { controller: "digits", action: "input->digits#strip" },
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>

        <div>
          <%= form.label :interval_days, "Intervalo entre parcelas (dias)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <div class="mt-1">
            <%= form.text_field :interval_days,
              inputmode: "numeric",
              placeholder: "Ex.: 30",
              data: { controller: "digits", action: "input->digits#strip" },
              class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
        </div>
      </div>

      <div>
        <%= form.label :day_offsets_list, "Vencimentos personalizados (dias)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <div class="mt-1">
          <%= form.text_field :day_offsets_list,
            placeholder: "Ex.: 0, 30, 60",
            class: "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </div>
        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Para prazos irregulares. Quando preenchido, ignora o nº de parcelas e o intervalo acima.</p>
      </div>
    </fieldset>

    <div>
      <%= form.label :description, "Descrição", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <div class="mt-1">
        <%= form.text_area :description, rows: 4,
          class: "w-full rounded-lg border px-3 py-2 text-sm resize-none bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>
    </div>

    <div>
      <label class="inline-flex items-center gap-3">
        <%= form.check_box :active, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>
        <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Ativa</span>
      </label>
    </div>

    <div class="flex items-center justify-end gap-4">
      <%= link_to "Cancelar", payment_terms_path, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200" %>
      <%= form.submit @payment_term.persisted? ? "Atualizar condição" : "Criar condição",
        class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700" %>
    </div>
  </div>
<% end %>
