<%
  input = "w-full rounded-lg border px-3 py-2 text-sm bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-indigo-500"
  label = "block text-sm font-medium text-gray-700 dark:text-gray-300"
  hint = "mt-1 text-xs text-gray-500 dark:text-gray-400"
  card = "rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 sm:p-6"
  status_badge = {
    "pending" => "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300",
    "running" => "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200",
    "succeeded" => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-200",
    "failed" => "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300"
  }
%>

<div class="max-w-4xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">Backup</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Cópia de todo o banco de dados (todas as empresas), enviada para o Google Drive manualmente ou no horário agendado.
    </p>
  </div>

  <%# Conexão com o Google Drive %>
  <div class="<%= card %>">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Google Drive</h2>
        <% if @setting.drive_connected? %>
          <p class="mt-1 text-sm text-emerald-700 dark:text-emerald-300">
            Conectado como <strong><%= @setting.google_account_email.presence || "conta Google" %></strong>
            · pasta <strong><%= @setting.drive_folder_name %></strong>
          </p>
        <% elsif @setting.google_app_configured? %>
          <p class="mt-1 text-sm text-amber-700 dark:text-amber-300">Client ID e Secret salvos. Falta autorizar a conta Google.</p>
        <% else %>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Não configurado. Siga os passos abaixo e salve o Client ID e o Client Secret.</p>
        <% end %>
      </div>

      <div class="flex gap-2">
        <% if @setting.google_app_configured? %>
          <%= link_to (@setting.drive_connected? ? "Reconectar conta" : "Conectar conta Google"), new_admin_google_drive_connection_path,
                data: { turbo: false },
                class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
        <% end %>

        <% if @setting.drive_connected? %>
          <%= button_to "Desconectar", admin_google_drive_connection_path, method: :delete,
                form: { data: { turbo_confirm: "Desconectar o Google Drive? O backup automático será desativado." } },
                class: "inline-flex items-center rounded-lg border border-red-300 px-4 py-2 text-sm font-medium text-red-700 hover:bg-red-50 dark:border-red-800 dark:text-red-300 dark:hover:bg-red-950" %>
        <% end %>
      </div>
    </div>

    <details class="mt-4 rounded-lg bg-gray-50 dark:bg-gray-950 p-4 text-sm text-gray-700 dark:text-gray-300" <%= "open" unless @setting.google_app_configured? %>>
      <summary class="cursor-pointer font-medium">Como criar o acesso ao Google Drive</summary>
      <ol class="mt-3 list-decimal space-y-2 pl-5">
        <li>Em <span class="font-medium">console.cloud.google.com</span>, entre com a conta Google que vai guardar os backups e crie um projeto.</li>
        <li>Em <span class="font-medium">APIs e serviços → Biblioteca</span>, ative a <span class="font-medium">Google Drive API</span>.</li>
        <li>Em <span class="font-medium">Tela de consentimento OAuth</span>, escolha <span class="font-medium">Externo</span>, preencha o nome do app e o e-mail e, no fim, clique em <span class="font-medium">Publicar app</span> (status "Em produção"). Em "Teste", o Google derruba a autorização a cada 7 dias.</li>
        <li>Em <span class="font-medium">Credenciais → Criar credenciais → ID do cliente OAuth</span>, escolha <span class="font-medium">Aplicativo da Web</span> e cadastre este URI de redirecionamento autorizado:
          <code class="mt-1 block break-all rounded bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 px-2 py-1 text-xs"><%= @redirect_uri %></code>
        </li>
        <li>Copie o <span class="font-medium">Client ID</span> e o <span class="font-medium">Client Secret</span> para os campos abaixo, salve e clique em <span class="font-medium">Conectar conta Google</span>.</li>
      </ol>
      <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
        O app só tem acesso aos arquivos que ele mesmo cria no Drive (a pasta de backups), nunca ao resto da conta.
      </p>
    </details>
  </div>

  <%= form_with model: @setting, url: admin_backup_path, method: :patch, class: "space-y-6" do |f| %>
    <%= render "shared/form_errors", resource: @setting %>

    <div class="<%= card %> space-y-4">
      <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Destino</h2>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <%= f.label :google_client_id, "Client ID", class: label %>
          <%= f.text_field :google_client_id, autocomplete: "off", class: "mt-1 #{input}" %>
        </div>

        <div>
          <%= f.label :google_client_secret, "Client Secret", class: label %>
          <%= f.password_field :google_client_secret, value: nil, autocomplete: "new-password",
                placeholder: (@setting.google_client_secret.present? ? "•••••••• (salvo; preencha só para trocar)" : nil),
                class: "mt-1 #{input}" %>
        </div>
      </div>

      <div>
        <%= f.label :drive_folder_name, "Pasta no Google Drive", class: label %>
        <%= f.text_field :drive_folder_name, class: "mt-1 #{input}" %>
        <p class="<%= hint %>">Criada pelo app no primeiro envio. Trocar o Client ID desconecta a conta.</p>
      </div>
    </div>

    <div class="<%= card %> space-y-4" data-controller="backup-schedule">
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Backup automático</h2>
        <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
          <%= f.check_box :schedule_enabled, class: "rounded border-gray-300 dark:border-gray-700 text-indigo-600 focus:ring-indigo-500" %>
          Ativar
        </label>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <%= f.label :frequency, "Frequência", class: label %>
          <%= f.select :frequency, BackupSetting::FREQUENCIES.invert, {},
                data: { backup_schedule_target: "frequency", action: "change->backup-schedule#toggle" },
                class: "mt-1 #{input}" %>
        </div>

        <div>
          <%= f.label :time_of_day, "Horário", class: label %>
          <%= f.time_field :time_of_day, value: @setting.time_of_day, class: "mt-1 #{input}" %>
        </div>

        <div data-backup-schedule-target="weekday">
          <%= f.label :weekday, "Dia da semana", class: label %>
          <%= f.select :weekday, BackupSetting::WEEKDAYS.each_with_index.to_a, {}, class: "mt-1 #{input}" %>
        </div>

        <div data-backup-schedule-target="monthDay">
          <%= f.label :month_day, "Dia do mês", class: label %>
          <%= f.number_field :month_day, min: 1, max: 28, class: "mt-1 #{input}" %>
        </div>
      </div>

      <p class="text-sm text-gray-600 dark:text-gray-300">
        <% if @setting.schedule_enabled? && @setting.next_run_at.present? %>
          <%= @setting.schedule_description %>. Próximo backup:
          <strong><%= l(@setting.next_run_at, format: "%d/%m/%Y %H:%M") %></strong>.
        <% else %>
          Desativado.
        <% end %>
        <span class="<%= hint %> block">Horário de Brasília. Se o sistema estiver fora do ar no horário, o backup roda assim que ele voltar.</span>
      </p>
    </div>

    <div class="flex justify-end">
      <%= f.submit "Salvar configuração", class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 cursor-pointer" %>
    </div>
  <% end %>

  <%# Backup manual %>
  <div class="<%= card %>">
    <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Backup manual</h2>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
      Envie um backup agora para o Google Drive (roda em segundo plano) ou baixe o arquivo direto no computador.
    </p>

    <div class="mt-4 flex flex-wrap gap-2">
      <% if @setting.drive_connected? %>
        <%= button_to "Enviar backup agora ao Google Drive", run_admin_backup_path,
              class: "inline-flex items-center rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700" %>
      <% else %>
        <button type="button" disabled title="Conecte o Google Drive primeiro"
                class="inline-flex items-center rounded-lg bg-indigo-600/50 px-4 py-2 text-sm font-medium text-white cursor-not-allowed">
          Enviar backup agora ao Google Drive
        </button>
      <% end %>

      <%= link_to "Baixar backup", download_admin_backup_path, data: { turbo: false },
            class: "inline-flex items-center rounded-lg border border-gray-300 dark:border-gray-700 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800" %>
    </div>

    <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
      Para restaurar um backup num banco novo: <code>bin/rails db:create db:schema:load</code> e depois
      <code>bin/rails backup:restore FILE=arquivo.sql.gz</code>.
    </p>
  </div>

  <%# Histórico %>
  <div class="<%= card %>">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-semibold text-gray-900 dark:text-gray-100">Histórico</h2>
      <% if @backups.any? { |backup| %w[pending running].include?(backup.status) } %>
        <%= link_to "Atualizar", admin_backup_path, class: "text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-400" %>
      <% end %>
    </div>

    <% if @backups.any? %>
      <div class="mt-4 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 dark:border-gray-800 text-left text-gray-500 dark:text-gray-400">
              <th class="py-2 pr-4 font-medium">Data</th>
              <th class="py-2 pr-4 font-medium">Tipo</th>
              <th class="py-2 pr-4 font-medium">Status</th>
              <th class="py-2 pr-4 font-medium">Tamanho</th>
              <th class="py-2 pr-4 font-medium">Arquivo</th>
            </tr>
          </thead>
          <tbody>
            <% @backups.each do |backup| %>
              <tr class="border-b border-gray-100 dark:border-gray-800 align-top">
                <td class="py-2 pr-4 whitespace-nowrap"><%= l(backup.created_at, format: "%d/%m/%Y %H:%M") %></td>
                <td class="py-2 pr-4">
                  <%= backup.trigger_label %>
                  <% if backup.requested_by %>
                    <span class="block text-xs text-gray-500 dark:text-gray-400"><%= backup.requested_by.name.presence || backup.requested_by.email %></span>
                  <% end %>
                </td>
                <td class="py-2 pr-4">
                  <span class="inline-flex items-center rounded-lg px-2 py-1 text-xs <%= status_badge[backup.status] %>"><%= backup.status_label %></span>
                  <% if backup.failed? && backup.error_message.present? %>
                    <span class="mt-1 block max-w-md text-xs text-red-700 dark:text-red-300"><%= backup.error_message %></span>
                  <% end %>
                </td>
                <td class="py-2 pr-4 whitespace-nowrap"><%= backup.size_bytes ? number_to_human_size(backup.size_bytes) : "—" %></td>
                <td class="py-2 pr-4">
                  <% if backup.drive_file_url.present? %>
                    <%= link_to backup.filename, backup.drive_file_url, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 break-all" %>
                  <% else %>
                    <%= backup.filename.presence || "—" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">Nenhum backup gerado ainda.</p>
    <% end %>
  </div>
</div>
