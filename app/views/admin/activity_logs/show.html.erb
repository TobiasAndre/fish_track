<%
  meta = @log.resource_type.safe_constantize
  resource_label = (meta.respond_to?(:model_name) ? meta.model_name.human : @log.resource_type)
  event_labels = { "biometrics" => "Biometria", "loading" => "Carregamento", "mortality" => "Mortalidade", "feeding" => "Alimentação" }
  badge = { "create" => "bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300",
            "update" => "bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-300",
            "destroy" => "bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300" }[@log.action]
  field_label = ->(field) { meta.respond_to?(:human_attribute_name) ? meta.human_attribute_name(field) : field.humanize }
  show_value = lambda do |value|
    case value
    when nil then tag.span("—", class: "text-gray-400 dark:text-gray-500")
    when true then "Sim"
    when false then "Não"
    when Hash, Array then tag.code(JSON.generate(value), class: "text-xs")
    when String then value.presence || tag.span("(vazio)", class: "text-gray-400 dark:text-gray-500")
    else value.to_s
    end
  end
  changes = @log.field_changes
  info = "text-sm text-gray-900 dark:text-gray-100"
  label = "text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400"
%>

<%= turbo_frame_tag "activity_log_detail" do %>
  <div class="max-h-[88vh] overflow-y-auto">
    <div class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-gray-200 bg-white px-6 py-4 dark:border-gray-800 dark:bg-gray-900">
      <div>
        <h2 class="text-lg font-semibold">Detalhes da ação</h2>
        <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
          <span class="inline-flex items-center rounded-lg px-2 py-1 text-xs font-medium <%= badge %>"><%= @log.human_action %></span>
          <%= @log.description %>
        </p>
      </div>

      <% if turbo_frame_request? %>
        <button type="button" data-action="click->dialog#close" aria-label="Fechar"
          class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 hover:text-gray-800 dark:hover:bg-gray-800 dark:hover:text-gray-100 transition cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      <% else %>
        <%= link_to "Voltar aos logs", admin_activity_logs_path, class: "shrink-0 text-sm text-indigo-600 dark:text-indigo-400 hover:underline" %>
      <% end %>
    </div>

    <div class="space-y-6 px-6 py-5">
      <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
        <div>
          <dt class="<%= label %>">Data e hora</dt>
          <dd class="<%= info %>"><%= l(@log.created_at, format: "%d/%m/%Y %H:%M:%S") %></dd>
        </div>

        <div>
          <dt class="<%= label %>">Usuário</dt>
          <dd class="<%= info %>">
            <%= @log.user&.name.presence || @log.user&.email || "—" %>
            <% if @log.user&.name.present? %><span class="text-gray-500 dark:text-gray-400">(<%= @log.user.email %>)</span><% end %>
          </dd>
        </div>

        <div>
          <dt class="<%= label %>">Empresa</dt>
          <dd class="<%= info %>"><%= @log.company&.name || "—" %></dd>
        </div>

        <div>
          <dt class="<%= label %>">Registro afetado</dt>
          <dd class="<%= info %>">
            <%= resource_label %><% if @log.resource_id %> <span class="text-gray-500 dark:text-gray-400">#<%= @log.resource_id %></span><% end %>
            <% if @log.event_type.present? %><span class="text-gray-500 dark:text-gray-400">· <%= event_labels[@log.event_type] || @log.event_type %></span><% end %>
          </dd>
        </div>

        <div class="sm:col-span-2">
          <dt class="<%= label %>">IP e localização</dt>
          <dd class="<%= info %>" data-ip-location>
            <% if @log.ip_address.blank? %>
              <span class="text-gray-500 dark:text-gray-400">IP não registrado.</span>
            <% else %>
              <span class="font-mono"><%= @log.ip_address %></span>
              <% if @location&.found? %>
                — <%= @location.place || "Localização não informada" %>
                <% if @location.isp.present? %><span class="text-gray-500 dark:text-gray-400">· Provedor: <%= @location.isp %></span><% end %>
                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Localização aproximada, estimada a partir do IP (pode indicar a cidade do provedor).</p>
              <% elsif @location&.local? %>
                — <span class="text-gray-600 dark:text-gray-300"><%= @location.place %></span>
              <% else %>
                — <span class="text-gray-500 dark:text-gray-400">localização indisponível no momento.</span>
              <% end %>
            <% end %>
          </dd>
        </div>
      </dl>

      <% if @log.snapshot? %>
        <section>
          <h3 class="mb-2 text-sm font-semibold">
            <%= { "create" => "Dados gravados", "update" => "O que mudou", "destroy" => "Dados removidos" }[@log.action] %>
          </h3>

          <% if changes.any? %>
            <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-800">
              <table class="w-full text-sm">
                <thead class="bg-gray-50 text-left text-xs text-gray-500 dark:bg-gray-950 dark:text-gray-400">
                  <tr>
                    <th class="px-3 py-2 font-medium">Campo</th>
                    <th class="px-3 py-2 font-medium">Antes</th>
                    <th class="px-3 py-2 font-medium">Depois</th>
                  </tr>
                </thead>

                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                  <% changes.each do |change| %>
                    <tr>
                      <td class="px-3 py-2 align-top">
                        <div class="font-medium"><%= field_label.call(change.field) %></div>
                        <div class="font-mono text-[11px] text-gray-400 dark:text-gray-500"><%= change.field %></div>
                      </td>
                      <td class="px-3 py-2 align-top break-words text-red-700 dark:text-red-300"><%= show_value.call(change.before) %></td>
                      <td class="px-3 py-2 align-top break-words text-emerald-700 dark:text-emerald-300"><%= show_value.call(change.after) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-gray-500 dark:text-gray-400">Nenhum campo do registro mudou nesta ação.</p>
          <% end %>
        </section>

        <section class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          <% { "Objeto antes (JSON)" => @log.object_before, "Objeto depois (JSON)" => @log.object_after }.each do |title, object| %>
            <details class="rounded-xl border border-gray-200 dark:border-gray-800">
              <summary class="cursor-pointer px-3 py-2 text-sm font-medium"><%= title %></summary>
              <% if object.nil? %>
                <p class="px-3 pb-3 text-sm text-gray-500 dark:text-gray-400">
                  <%= title.include?("antes") ? "Não existia antes desta ação." : "Não existe depois desta ação." %>
                </p>
              <% else %>
                <pre class="max-h-72 overflow-auto whitespace-pre-wrap break-words border-t border-gray-100 bg-gray-50 p-3 text-xs dark:border-gray-800 dark:bg-gray-950"><%= JSON.pretty_generate(object) %></pre>
              <% end %>
            </details>
          <% end %>
        </section>
      <% else %>
        <p class="rounded-xl border border-dashed border-gray-300 p-4 text-sm text-gray-500 dark:border-gray-700 dark:text-gray-400">
          Este registro é anterior à gravação do objeto antes e depois da ação, então não há detalhamento dos dados.
        </p>
      <% end %>
    </div>
  </div>
<% end %>
